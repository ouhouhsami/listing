# Postgres local
DATABASE_URL=postgres://listing:motdepasse@localhost:5432/listing

# Secret pour signer les sessions et magic links (64 chars aléatoires)
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# URL publique du site (pour les liens dans les emails)
SITE_URL=https://votre-domaine.fr

# Resend — envoi d'emails (magic link + contact)
# Laisser vide en dev : les emails s'affichent dans la console
RESEND_API_KEY=
EMAIL_FROM=listing <contact@votre-domaine.fr>

# Destinataire des demandes de contact
CONTACT_EMAIL=vous@exemple.fr

# Port d'écoute (défaut 3000)
PORT=3000
